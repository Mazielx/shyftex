// Shopping Optimizer — Prisma Schema (PostgreSQL)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shoppingLists ShoppingList[]
  missions      Mission[]
  purchases     Purchase[]
  savings       Savings[]
  vehicles      Vehicle[]
  preferences   UserPreferences?
  subscription  Subscription?
}

model ShoppingList {
  id               String   @id @default(cuid())
  userId           String
  title            String
  rawInput         String
  status           String   @default("DRAFT")
  itemCount        Int      @default(0)
  parsedItemCount  Int      @default(0)
  lastOptimizedAt  DateTime?
  isRecurring      Boolean  @default(false)
  recurringInterval String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   ShoppingItem[]
  missions Mission[]

  @@index([userId])
}

model ShoppingItem {
  id                  String   @id @default(cuid())
  listId              String
  rawInput            String
  normalizedName      String?
  category            String?
  brand               String?
  presentation        String?
  quantity            Float    @default(1)
  unit                String   @default("pieza")
  size                String?
  barcode             String?
  exactProductId      String?
  allowsSubstitution  Boolean  @default(true)
  brandRestrictions   String   @default("[]")
  substituteProductIds String  @default("[]")
  priority            String   @default("REQUIRED")
  isRequired          Boolean  @default(true)
  notes               String   @default("")
  matchedProductId    String?
  matchLevel          String   @default("EXACT_MATCH")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  list ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

model Store {
  id           String  @id @default(cuid())
  retailerId   String
  retailerName String
  name         String
  address      String
  city         String
  state        String
  zipCode      String
  latitude     Float
  longitude    Float
  phone        String?
  hours        String  @default("[]")
  services     String  @default("[]")
  isMock       Boolean @default(false)
  source       String

  @@index([city])
  @@index([retailerId])
}

model Mission {
  id                     String    @id @default(cuid())
  userId                 String
  planId                 String
  listId                 String
  status                 String    @default("PENDING")
  totalExpectedCostCents Int       @default(0)
  totalActualCostCents   Int?
  storeCount             Int       @default(0)
  storesVisited          Int       @default(0)
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  list  ShoppingList  @relation(fields: [listId], references: [id])
  items MissionItem[]

  @@index([userId])
  @@index([listId])
}

model MissionItem {
  id                    String   @id @default(cuid())
  missionId             String
  storeId               String
  shoppingItemId        String
  productName           String
  quantity              Float    @default(1)
  unit                  String   @default("pieza")
  expectedPriceCents    Int
  status                String   @default("PENDING")
  substitutionProductId String?
  actualPriceCents      Int?
  notes                 String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  missionId   String
  storeId     String
  productId   String?
  productName String
  quantity    Float    @default(1)
  unit        String   @default("pieza")
  priceCents  Int
  currency    String   @default("MXN")
  purchasedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([missionId])
}

model Savings {
  id                 String   @id @default(cuid())
  userId             String
  planId             String
  missionId          String?
  baselineCostCents  Int
  optimizedCostCents Int
  transportCostCents Int      @default(0)
  netSavingsCents    Int
  savedAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Vehicle {
  id                         String   @id @default(cuid())
  userId                     String
  name                       String
  make                       String?
  model                      String?
  year                       Int?
  fuelType                   String   @default("GASOLINE")
  customEfficiencyKmPerLiter Float?
  isDefault                  Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserPreferences {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  defaultOptimizationMode String   @default("BALANCED")
  maxBudgetCents          Int?
  maxTravelDistanceKm     Float?
  maxTravelTimeMinutes    Int?
  preferredStoreIds       String   @default("[]")
  excludedStoreIds        String   @default("[]")
  preferredBrands         String   @default("[]")
  dietaryRestrictions     String   @default("[]")
  currency                String   @default("MXN")
  language                String   @default("es")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String   @unique
  stripeCustomerId   String?
  stripeSubscriptionId String?
  plan               String   @default("FREE")
  status             String   @default("ACTIVE")
  optimizationsUsed  Int      @default(0)
  optimizationsLimit Int      @default(5)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
