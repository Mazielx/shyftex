{
  "expo": {
    "name": "SHYFTEX",
    "slug": "shyftex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "shyftex",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shyftex.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SHYFTEX necesita tu ubicacion para encontrar tiendas cercanas y optimizar tus rutas de compra."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B7A3D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.shyftex.app",
      "versionCode": 1,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SHYFTEX to use your location to find nearby stores and optimize your shopping route."
        }
      ],
      "expo-secure-store"
    ]
  }
}
